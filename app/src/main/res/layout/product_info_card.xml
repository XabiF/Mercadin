<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/product_info_card_padding"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="blocksDescendants"
        android:padding="@dimen/product_info_card_padding">

        <TextView
            android:id="@+id/text_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mercadona"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/product_info_card_padding"
            android:layout_marginTop="@dimen/product_info_card_padding"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/icon_item"
            app:layout_constraintBottom_toTopOf="@id/icon_item" />

        <!-- Icon -->
        <ImageView
            android:id="@+id/icon_item"
            android:layout_width="@dimen/product_icon_size"
            android:layout_height="@dimen/product_icon_size"
            android:layout_marginStart="@dimen/product_info_card_padding"
            android:layout_marginEnd="@dimen/product_info_card_padding"
            android:layout_marginTop="@dimen/product_info_card_padding"
            android:layout_marginBottom="@dimen/product_info_card_padding"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="dricon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_source"
            app:layout_constraintEnd_toStartOf="@id/text_item_title"
            app:layout_constraintDimensionRatio="H,1:1" />

        <!-- Title -->
        <TextView
            android:id="@+id/text_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Item Title"
            android:textStyle="bold"
            android:textSize="16sp"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/product_info_card_padding"
            android:layout_marginTop="@dimen/product_info_card_padding"
            android:layout_marginEnd="@dimen/product_info_card_padding"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_item"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Left bottom label -->
        <TextView
            android:id="@+id/text_item_unit_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.50 €"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/text_item_title"
            app:layout_constraintTop_toBottomOf="@id/text_item_title"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/text_item_ref_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.00 € / kg"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/text_item_title"
            app:layout_constraintTop_toBottomOf="@id/text_item_unit_price"
            android:layout_marginTop="4dp" />

        <!-- Right bottom label -->
        <TextView
            android:id="@+id/text_item_sale_unit_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.50 €"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/text_item_sale_ref_price"
            app:layout_constraintTop_toBottomOf="@id/text_item_title"
            app:layout_constraintStart_toStartOf="@id/text_item_sale_ref_price"
            android:layout_marginEnd="@dimen/product_info_card_padding"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text_item_sale_ref_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.00 € / kg"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toRightOf="@id/text_item_ref_price"
            app:layout_constraintTop_toTopOf="@id/text_item_ref_price"
            app:layout_constraintBottom_toBottomOf="@id/text_item_ref_price"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="0dp" />

        <TextView
            android:id="@+id/text_list_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="2"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/button_list_remove"
            app:layout_constraintTop_toTopOf="@id/button_list_remove"
            android:layout_marginEnd="@dimen/product_info_card_padding"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/product_info_card_padding"/>

        <ImageButton
            android:id="@+id/button_list_remove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_remove"
            android:background="@drawable/bg_circle"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="ng/cart_icon"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"

            app:layout_constraintEnd_toStartOf="@id/button_list_add"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_item_ref_price"
            android:layout_marginTop="@dimen/product_info_card_padding"
            android:layout_marginBottom="@dimen/product_info_card_padding"
            android:layout_marginRight="@dimen/product_info_card_padding"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/button_list_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/bg_circle"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="ing/saved_icon"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/product_info_card_padding"
            android:layout_marginEnd="@dimen/product_info_card_padding"
            app:tint="@android:color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
